{"h1": "\\dfrac{x+3}{x}", "h2": "\\dfrac{\\textcolor{#D94A4A}{\\cancel{x}}+3}{\\textcolor{#D94A4A}{\\cancel{x}}}\\;=\\;3", "n1": "\\dfrac{4+2}{2}", "n1b": "=\\dfrac{6}{2}=\\;\\textcolor{#1E9E5A}{3}", "n2": "\\dfrac{4+\\textcolor{#D94A4A}{\\cancel{2}}}{\\textcolor{#D94A4A}{\\cancel{2}}}", "n2b": "=\\;4+1=\\;\\textcolor{#D94A4A}{5}", "ok": "\\dfrac{\\textcolor{#1E9E5A}{\\cancel{x}}\\cdot 3}{\\textcolor{#1E9E5A}{\\cancel{x}}\\cdot 5}=\\dfrac{3}{5}", "mal": "\\dfrac{x+3}{x}\\neq 3", "frac": "\\dfrac{x^{2}-4}{x^{2}-x-2}", "num": "x^{2}-4\\;=\\;", "d1": "\\textcolor{#E8632A}{(x-2)}", "d2": "\\textcolor{#2F6FED}{(x+2)}", "den": "x^{2}-x-2\\;=\\;", "d3": "\\textcolor{#E8632A}{(x-2)}", "d4": "\\textcolor{#2F6FED}{(x+1)}", "f1": "\\dfrac{\\textcolor{#E8632A}{(x-2)}(x+2)}{\\textcolor{#E8632A}{(x-2)}(x+1)}", "f2": "\\dfrac{\\textcolor{#D94A4A}{\\cancel{(x-2)}}(x+2)}{\\textcolor{#D94A4A}{\\cancel{(x-2)}}(x+1)}", "res": "\\dfrac{x+2}{x+1}", "dif": "a^{2}-b^{2}=(a-b)(a+b)", "neq": "3\\neq 5"}