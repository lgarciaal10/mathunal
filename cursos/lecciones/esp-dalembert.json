     }
    ]
   },
   {
    "titulo": "La fórmula",
    "corto": "Fórmula",
    "bloques": [
     {
      "t": "p",
      "html": "La solución general es suma de dos ondas viajeras. Los datos iniciales fijan cuáles."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "u(x,t)=F(x-ct)+G(x+ct)",
        "porque": "Toda solución de la ecuación de onda tiene esta forma."
       },
       {
        "tex": "u(x,0)=f(x),\\ u_{t}(x,0)=0\\ \\Rightarrow\\ F=G=\\tfrac{1}{2}f",
        "porque": "Con velocidad inicial cero, las dos ondas son la mitad de f."
       },
       {
        "tex": "u=\\tfrac{1}{2}\\big[f(x-ct)+f(x+ct)\\big]",
        "porque": "La fórmula de D'Alembert."
       },
       {
        "tex": "u_{t}(x,0)=g\\ \\Rightarrow\\ +\\dfrac{1}{2c}\\displaystyle\\int_{x-ct}^{x+ct}g(s)\\,ds",
        "porque": "Si hay velocidad inicial, se suma este término."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Cada onda lleva la mitad de la forma inicial. Si se olvida el un medio, la altura inicial en t igual a 0 saldría el doble."
     }
    ]
   },
   {
    "titulo": "Un cálculo",
    "corto": "Cálculo",
    "bloques": [
     {
      "t": "p",
      "html": "Se aplica la fórmula con f igual a seno de x, y c igual a 2."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "u=\\tfrac{1}{2}\\big[\\operatorname{sen}(x+2t)+\\operatorname{sen}(x-2t)\\big]",
        "porque": "D'Alembert con f igual a seno."
       },
       {
        "tex": "\\operatorname{sen}A+\\operatorname{sen}B=2\\operatorname{sen}\\dfrac{A+B}{2}\\cos\\dfrac{A-B}{2}",
        "porque": "Identidad de suma de senos."
       },
       {
        "tex": "u=\\operatorname{sen}x\\cos2t",
        "porque": "Coincide con el modo de la cuerda de largo pi."
       },
       {
        "tex": "x=\\dfrac{\\pi}{2},\\ t=\\dfrac{\\pi}{4}:\\ u=1\\cdot\\cos\\dfrac{\\pi}{2}=0",
        "porque": "Un valor concreto."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Con f igual a seno de x, D'Alembert y la separación de variables dan el mismo resultado. Son dos caminos para la misma solución."
     }
    ]
