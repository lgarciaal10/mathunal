     }
    ]
   },
   {
    "titulo": "Las operaciones",
    "corto": "Resumen",
    "bloques": [
     {
      "t": "p",
      "html": "Estas son las operaciones con los conjuntos del ejemplo."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "A\\cup B=\\{1,2,3,4\\}",
        "porque": "Unión. Está en A, en B o en ambos."
       },
       {
        "tex": "A\\cap B=\\{2,3\\}",
        "porque": "Intersección. Está en A y en B."
       },
       {
        "tex": "A-B=\\{1\\}",
        "porque": "Diferencia. Está en A y no está en B."
       },
       {
        "tex": "A\\,\\triangle\\,B=(A-B)\\cup(B-A)=\\{1,4\\}",
        "porque": "Diferencia simétrica. Está en uno solo de los dos."
       },
       {
        "tex": "A^{c}=\\{4,5\\}",
        "porque": "Complemento de A en el universo del 1 al 5."
       },
       {
        "tex": "\\{a,b\\}\\times\\{1,2,3\\}\\ \\text{tiene}\\ 2\\cdot3=6\\ \\text{pares}",
        "porque": "Producto cartesiano. Se multiplican las cantidades."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "La diferencia no es conmutativa, porque A menos B no es B menos A. Y en un producto cartesiano el orden importa, así que el par a, 1 no es el par 1, a."
     }
    ]
   },
   {
    "titulo": "Cómo se cuenta",
    "corto": "Contar",
    "bloques": [
     {
      "t": "p",
      "html": "Para contar una unión no basta sumar, porque los elementos comunes se contarían dos veces."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "|A\\cup B|=|A|+|B|-|A\\cap B|",
        "porque": "Inclusión y exclusión. Se resta lo que se contó doble."
       },
       {
        "tex": "|A|=3,\\ |B|=3,\\ |A\\cap B|=2",
        "porque": "Los datos del ejemplo."
       },
       {
        "tex": "|A\\cup B|=3+3-2=4",
        "porque": "Resultado."
       }
      ]
     },
