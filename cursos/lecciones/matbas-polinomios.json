     {
      "t": "pasos",
      "items": [
       {
        "tex": "P(1)=1-6+11-6=0\\ \\Rightarrow\\ (x-1)\\ \\text{es factor}",
        "porque": "Se prueba con un divisor del término independiente."
       },
       {
        "tex": "x^{3}-6x^{2}+11x-6=(x-1)\\left(x^{2}-5x+6\\right)",
        "porque": "La división da un cuadrático."
       },
       {
        "tex": "x^{2}-5x+6=(x-2)(x-3)",
        "porque": "Se factoriza el cuadrático."
       },
       {
