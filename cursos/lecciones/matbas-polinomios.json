   {
    "titulo": "Los dos teoremas",
    "corto": "Teoremas",
    "bloques": [
     {
      "t": "p",
      "html": "Estos son los teoremas, con el ejemplo."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "P(x)=(x-c)\\,Q(x)+r\\ \\Rightarrow\\ r=P(c)",
        "porque": "Teorema del residuo. Se reemplaza x por c y el término con x menos c desaparece."
       },
       {
        "tex": "P(c)=0\\ \\Leftrightarrow\\ (x-c)\\ \\text{es factor de}\\ P(x)",
        "porque": "Teorema del factor. Si el residuo es 0, la división es exacta."
       },
       {
        "tex": "P(4)=64-96+44-6=6",
        "porque": "El residuo de dividir el ejemplo entre x menos 4."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Para dividir entre x más 3 se usa c igual a menos 3. Hay que escribir el divisor como x menos c."
     }
