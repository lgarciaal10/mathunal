      "t": "p",
      "html": "Primero se escribe la ecuación en la forma y prima más p de x por y igual a q de x. Después se calcula el factor integrante."
     },
     {
      "t": "eq",
      "tex": "\\mu(x)=e^{\\int p(x)\\,dx}"
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "y'+2y=4,\\quad p(x)=2,\\quad q(x)=4",
        "porque": "Es la forma estándar."
       },
       {
        "tex": "\\mu(x)=e^{\\int 2\\,dx}=e^{2x}",
        "porque": "Se integra p. No hace falta sumar constante."
       },
       {
        "tex": "\\left(e^{2x}y\\right)'=4e^{2x}",
        "porque": "Al multiplicar por mu, el lado izquierdo es la derivada de mu por y."
       },
       {
        "tex": "e^{2x}y=2e^{2x}+C\\ \\Rightarrow\\ y=2+Ce^{-2x}",
        "porque": "Se integra y se despeja."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Se multiplica toda la ecuación por mu, incluido el lado derecho."
     }
    ]
