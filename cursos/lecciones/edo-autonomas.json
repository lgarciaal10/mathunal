  "secciones": [
   {
    "titulo": "La idea",
    "bloques": [
     {
      "t": "p",
      "html": "En una ecuación {{gl:autonoma|autónoma}}, y prima igual a f de y, el comportamiento se puede entender sin resolverla. Basta ver dónde f vale 0, que son los puntos de {{gl:equilibrio|equilibrio}}, y qué signo tiene f entre ellos. Con eso se sabe hacia dónde van las soluciones y si cada equilibrio es {{gl:estable|estable}}."
     }
    ]
   },
   {
    "titulo": "Un ejemplo",
    "corto": "Un ejemplo",
    "bloques": [
     {
      "t": "p",
      "html": "Mira esta ecuación logística, un modelo de crecimiento con límite."
     },
     {
      "t": "eq",
      "tex": "y'=y\\,(2-y)"
     },
     {
      "t": "grafica",
      "animar": "dibujar",
      "alt": "El campo de pendientes y los dos equilibrios"
     }
    ]
   },
   {
    "titulo": "Piensa antes de ver",
    "corto": "Piensa",
    "bloques": [
     {
      "t": "piensa",
      "pregunta": "En y igual a 1 la pendiente es y por (2 menos y). ¿Cuánto vale?",
      "opciones": [
       0,
       1,
       2,
       3
      ],
      "correcta": 1,
      "bien": "Muy bien. Vale 1, así que la solución sube. Más abajo se ve.",
      "mal": "Vale 1, porque 1 por (2 menos 1) es 1. La solución sube ahí. Más abajo se ve."
     }
    ]
   },
   {
    "titulo": "Hacia el equilibrio",
    "corto": "Hacia el equilibrio",
    "bloques": [
     {
      "t": "p",
      "html": "Mira cómo se mueve la solución con valores iniciales distintos."
     },
     {
      "t": "acercando",
      "ds": [
       0.3,
       0.5,
       1.5,
       2.8
      ],
      "alt": "La solución para varios valores iniciales"
     },
     {
      "t": "p",
      "html": "Todas las soluciones que parten entre 0 y 3 se acercan a 2."
     }
    ]
   },
   {
    "titulo": "Los equilibrios",
    "corto": "Equilibrios",
    "bloques": [
     {
      "t": "p",
      "html": "Los equilibrios salen de resolver f de y igual a 0."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "y(2-y)=0\\ \\Rightarrow\\ y=0\\ \\text{o}\\ y=2",
        "porque": "Son los dos equilibrios."
       },
       {
        "tex": "y'=y-2\\ \\Rightarrow\\ y=2",
        "porque": "Con f igual a y menos 2 solo hay un equilibrio, el 2."
       }
      ]
     }
    ]
   },
   {
    "titulo": "La estabilidad",
    "corto": "Estabilidad",
    "bloques": [
     {
      "t": "p",
      "html": "Se mira el signo de f a cada lado de cada equilibrio."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "0<y<2:\\ f>0\\ \\Rightarrow\\ y\\ \\text{sube}",
        "porque": "Entre los equilibrios la solución sube."
       },
       {
        "tex": "y>2:\\ f<0\\ \\Rightarrow\\ y\\ \\text{baja}",
        "porque": "Arriba de 2 la solución baja hacia 2."
       },
       {
        "tex": "y=2\\ \\text{estable (sumidero)},\\quad y=0\\ \\text{inestable (fuente)}",
        "porque": "Un equilibrio es estable si las soluciones llegan a él desde los dos lados."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Si f cambia de signo de más a menos al subir y, el equilibrio es estable. Si cambia de menos a más, es inestable."
     }
    ]
   },
   {
    "titulo": "Con la derivada",
    "corto": "Con la derivada",
    "bloques": [
     {
      "t": "p",
      "html": "Otra forma es mirar la derivada de f."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "f'(y)=2-2y",
        "porque": "Se deriva f."
       },
       {
        "tex": "f'(2)=-2<0\\ \\Rightarrow\\ \\text{estable}",
        "porque": "Una derivada negativa en el equilibrio dice que es estable."
       },
       {
        "tex": "f'(0)=2>0\\ \\Rightarrow\\ \\text{inestable}",
        "porque": "Una derivada positiva dice que es inestable."
       }
      ]
     }
    ]
   },
