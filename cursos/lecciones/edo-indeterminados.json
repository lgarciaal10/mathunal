     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "y''+4y=\\cos t,\\quad y_{p}=A\\cos t+B\\operatorname{sen}t",
        "porque": "La fuerza es un coseno. Se proponen un coseno y un seno, porque al derivar uno aparece el otro."
       },
       {
        "tex": "y_{p}''=-A\\cos t-B\\operatorname{sen}t",
        "porque": "Se deriva dos veces."
       },
       {
        "tex": "3A\\cos t+3B\\operatorname{sen}t=\\cos t",
        "porque": "Se reemplaza en la ecuación y se agrupa."
       },
       {
        "tex": "A=\\dfrac{1}{3},\\quad B=0\\ \\Rightarrow\\ y_{p}=\\dfrac{1}{3}\\cos t",
        "porque": "Se igualan los coeficientes de coseno y de seno a ambos lados."
       }
      ]
     }
    ]
   },
   {
    "titulo": "Qué forma proponer",
    "corto": "Qué proponer",
    "bloques": [
