 "leer": {
  "secciones": [
   {
    "titulo": "La idea",
    "bloques": [
     {
      "t": "p",
      "html": "Toda función periódica razonable se puede escribir como una suma de senos y cosenos, que es su {{gl:fourier|serie de Fourier}}. Los {{gl:coeficientes|coeficientes}} salen de integrales. Si la función es {{gl:par|par}}, solo aparecen cosenos, y si es {{gl:impar|impar}}, solo aparecen senos. Reconocer la simetría ahorra la mitad del trabajo."
     }
    ]
   },
   {
    "titulo": "Un ejemplo",
    "corto": "Un ejemplo",
    "bloques": [
     {
      "t": "p",
      "html": "La función f de x igual a x entre menos pi y pi es impar. Mira cómo la serie, solo con senos, se acerca a ella al sumar más términos."
     },
     {
      "t": "eq",
      "tex": "x=\\sum_{n=1}^{\\infty}\\dfrac{2(-1)^{n+1}}{n}\\operatorname{sen}(nx)"
     },
     {
      "t": "grafica",
      "animar": "dibujar",
      "alt": "Las sumas parciales de la serie de Fourier"
     }
    ]
   },
   {
    "titulo": "Piensa antes de ver",
    "corto": "Piensa",
    "bloques": [
     {
      "t": "piensa",
      "pregunta": "En la serie de x, el coeficiente del primer seno es 2 por menos uno elevado a 2, entre 1. ¿Cuánto vale b1?",
      "opciones": [
       1,
       2,
       4,
       6
      ],
      "correcta": 2,
      "bien": "Muy bien. Vale 2, porque menos uno elevado a 2 es 1, y 2 por 1 entre 1 es 2. Más abajo se ve el primer seno.",
      "mal": "Vale 2, porque menos uno elevado a 2 es 1, y 2 por 1 entre 1 da 2. Más abajo se ve el primer seno."
     }
    ]
   },
   {
    "titulo": "Sumando términos",
    "corto": "Los términos",
    "bloques": [
     {
      "t": "p",
      "html": "Mira la suma parcial con 1, 3, 5 y 8 términos."
     },
     {
      "t": "acercando",
      "ds": [
       1,
       3,
       5,
       8
      ],
      "alt": "La suma parcial con cuatro cantidades de términos"
     },
     {
      "t": "p",
      "html": "Cada término nuevo corrige un poco más. Cerca de los extremos la serie tarda más en llegar a la recta."
     }
    ]
   },
   {
    "titulo": "Los coeficientes",
    "corto": "Los coeficientes",
    "bloques": [
     {
      "t": "p",
      "html": "Para una función con período 2 pi se usan estas fórmulas."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "a_{0}=\\dfrac{1}{\\pi}\\displaystyle\\int_{-\\pi}^{\\pi}f(x)\\,dx,\\quad a_{n}=\\dfrac{1}{\\pi}\\displaystyle\\int_{-\\pi}^{\\pi}f(x)\\cos(nx)\\,dx",
        "porque": "Los coeficientes de los cosenos."
       },
       {
        "tex": "b_{n}=\\dfrac{1}{\\pi}\\displaystyle\\int_{-\\pi}^{\\pi}f(x)\\operatorname{sen}(nx)\\,dx",
        "porque": "Los coeficientes de los senos."
       },
       {
        "tex": "f(x)\\sim\\dfrac{a_{0}}{2}+\\displaystyle\\sum_{n\\ge1}\\big(a_{n}\\cos nx+b_{n}\\operatorname{sen}nx\\big)",
        "porque": "La serie de Fourier."
       },
       {
        "tex": "f(x)=x:\\ b_{n}=\\dfrac{2}{n}(-1)^{n+1},\\ b_{1}=2",
        "porque": "Los coeficientes de la función del ejemplo."
       }
      ]
     }
    ]
   },
   {
    "titulo": "Simetrías",
    "corto": "Simetrías",
    "bloques": [
     {
      "t": "p",
      "html": "La paridad dice qué coeficientes se anulan."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "f\\ \\text{par}\\ \\Rightarrow\\ b_{n}=0",
        "porque": "Solo cosenos y el término constante."
       },
       {
        "tex": "f\\ \\text{impar}\\ \\Rightarrow\\ a_{0}=a_{n}=0",
        "porque": "Solo senos."
       },
       {
        "tex": "f(x)=|x|:\\ \\dfrac{a_{0}}{2}=\\dfrac{\\pi}{2}=1.5708",
        "porque": "Par. El promedio de la función es pi medios."
       },
       {
        "tex": "f(x)=x^{2}:\\ \\dfrac{a_{0}}{2}=\\dfrac{\\pi^{2}}{3}=3.2899,\\qquad f(x)=5:\\ \\text{solo el término constante}",
        "porque": "Otras funciones pares."
       }
      ]
     },
