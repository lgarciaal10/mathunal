      "t": "p",
      "html": "Para y prima igual a f de x y, con y de x0 igual a y0, el teorema de Picard y Lindelöf dice lo siguiente."
     },
     {
      "t": "eq",
      "tex": "f\\ \\text{y}\\ \\dfrac{\\partial f}{\\partial y}\\ \\text{continuas cerca de}\\ (x_{0},y_{0})\\ \\Rightarrow\\ \\text{hay una solución única}"
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "f(x,y)=3y^{2/3}\\ \\Rightarrow\\ \\dfrac{\\partial f}{\\partial y}=2y^{-1/3}",
        "porque": "La derivada tiene y en el denominador."
       },
       {
        "tex": "\\dfrac{\\partial f}{\\partial y}\\ \\text{no existe en}\\ y=0",
        "porque": "No es continua en el punto inicial (0, 0), y el teorema no asegura unicidad."
       },
       {
        "tex": "y'=x+y^{2},\\ y(0)=1\\ \\Rightarrow\\ \\text{solución única}",
        "porque": "Aquí f y su derivada son continuas en todo el plano."
       }
      ]
     },
     {
