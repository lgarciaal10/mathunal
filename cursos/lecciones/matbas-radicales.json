     }
    ]
   },
   {
    "titulo": "Ecuaciones con radicales",
    "corto": "Radicales",
    "bloques": [
     {
      "t": "p",
      "html": "Se aísla la raíz, se eleva al cuadrado y se comprueba."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "\\sqrt{x+4}=x-2\\ \\Rightarrow\\ x+4=(x-2)^{2}",
        "porque": "Se eleva al cuadrado los dos lados."
       },
       {
        "tex": "x+4=x^{2}-4x+4\\ \\Rightarrow\\ x^{2}-5x=0\\ \\Rightarrow\\ x=0\\ \\text{o}\\ x=5",
        "porque": "Se resuelve la ecuación cuadrática."
       },
       {
        "tex": "x=0:\\ \\sqrt{4}=2\\ne -2\\qquad x=5:\\ \\sqrt{9}=3=3",
        "porque": "Se comprueba en la ecuación original. Solo sirve x igual a 5."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "La comprobación no es opcional. Al elevar al cuadrado, menos 2 y 2 dan el mismo 4, y por eso aparece una solución que no sirve."
     }
    ]
   },
   {
    "titulo": "Valor absoluto",
    "corto": "Valor absoluto",
    "bloques": [
     {
      "t": "p",
      "html": "El valor absoluto de A igual a B, con B positivo, se divide en dos casos."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "|2x-1|=5",
        "porque": "La ecuación."
       },
       {
        "tex": "2x-1=5\\quad\\text{o}\\quad 2x-1=-5",
        "porque": "Se separan los dos casos."
       },
       {
        "tex": "x=3\\quad\\text{o}\\quad x=-2",
        "porque": "Se resuelve cada uno."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Si B es negativo, no hay solución, porque un valor absoluto nunca es negativo."
     }
    ]
