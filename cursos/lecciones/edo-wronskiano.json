   {
    "titulo": "Reducción de orden",
    "corto": "Reducción",
    "bloques": [
     {
      "t": "p",
      "html": "Se busca y2 igual a v por y1 y se reemplaza en la ecuación."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "y_{2}=v\\,e^{x}",
        "porque": "La forma buscada."
       },
       {
        "tex": "y_{2}'=(v'+v)e^{x},\\quad y_{2}''=(v''+2v'+v)e^{x}",
        "porque": "Se deriva con la regla del producto."
       },
       {
        "tex": "(v''+2v'+v)-2(v'+v)+v=v''=0",
        "porque": "Se reemplaza en la ecuación y casi todo se cancela."
