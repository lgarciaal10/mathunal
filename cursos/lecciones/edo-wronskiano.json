 "leer": {
  "secciones": [
   {
    "titulo": "La idea",
    "bloques": [
     {
      "t": "p",
      "html": "Una ecuación lineal de segundo orden necesita dos soluciones independientes para armar la solución general. A veces solo se conoce una. La {{gl:reduccion|reducción de orden}} fabrica la segunda a partir de la primera. Y el {{gl:wronskiano|Wronskiano}} es la prueba que dice si dos soluciones son {{gl:independientes|independientes}}."
     }
    ]
   },
   {
    "titulo": "Un ejemplo",
    "corto": "Un ejemplo",
    "bloques": [
     {
      "t": "p",
      "html": "Esta ecuación tiene la solución e a la x. Se busca una segunda."
     },
     {
      "t": "eq",
      "tex": "y''-2y'+y=0,\\qquad y_{1}=e^{x}"
     },
     {
      "t": "grafica",
      "animar": "dibujar",
      "alt": "La solución conocida y1"
     }
    ]
   },
   {
    "titulo": "Piensa antes de ver",
