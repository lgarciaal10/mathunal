   {
    "titulo": "Calcular términos",
    "corto": "Calcular",
    "bloques": [
     {
      "t": "p",
      "html": "Con la regla y los valores iniciales se calcula término por término."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "a_{n}=3a_{n-1},\\ a_{0}=2\\ \\Rightarrow\\ a_{1}=6,\\ a_{2}=18,\\ a_{3}=54",
        "porque": "Cada término es el triple del anterior."
       },
       {
        "tex": "a_{n}=2\\cdot3^{n}",
        "porque": "La fórmula cerrada de esta recurrencia."
       },
       {
        "tex": "F_{1}=F_{2}=1,\\ F_{3}=2,\\ F_{4}=3,\\ F_{5}=5,\\ F_{6}=8",
        "porque": "Los primeros términos de Fibonacci."
       }
      ]
     }
    ]
   },
   {
    "titulo": "La ecuación característica",
    "corto": "Característica",
    "bloques": [
     {
      "t": "p",
      "html": "Para recurrencias lineales de segundo orden se busca una solución de la forma r elevado a n."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "a_{n}=a_{n-1}+2a_{n-2}\\ \\Rightarrow\\ r^{2}-r-2=0",
        "porque": "Se reemplaza a de n por r elevado a n y se divide entre r elevado a n menos 2."
       },
       {
        "tex": "(r-2)(r+1)=0\\ \\Rightarrow\\ r=2\\ \\text{o}\\ r=-1",
        "porque": "Las raíces."
       },
       {
        "tex": "a_{n}=A\\,2^{n}+B\\,(-1)^{n}",
        "porque": "La solución general, con A y B según los valores iniciales."
       },
       {
        "tex": "a_{n}=5a_{n-1}-6a_{n-2}\\ \\Rightarrow\\ r^{2}=5r-6",
        "porque": "Otro ejemplo, con raíces 2 y 3."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "La ecuación característica pasa todos los términos al mismo lado con el signo cambiado. Un error de signo en ese paso da raíces equivocadas."
