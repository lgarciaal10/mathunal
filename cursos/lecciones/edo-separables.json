 "leer": {
  "secciones": [
   {
    "titulo": "La idea",
    "bloques": [
     {
      "t": "p",
      "html": "Una {{gl:edo|ecuación diferencial}} es una ecuación cuya incógnita es una función y que trae sus derivadas. Describen cómo cambian las cosas, como la temperatura de un motor, la carga de un condensador o la altura de un líquido. Las de {{gl:separable|variables separables}} son las más sencillas, porque se resuelven separando las variables e integrando cada lado."
     }
    ]
   },
   {
    "titulo": "Un ejemplo",
    "corto": "Un ejemplo",
    "bloques": [
     {
      "t": "p",
      "html": "Mira la ecuación diferencial siguiente. En cada punto del plano dice qué pendiente debe tener la solución."
     },
     {
      "t": "eq",
      "tex": "\\dfrac{dy}{dx}=-x\\,y"
     },
     {
      "t": "p",
      "html": "La gráfica dibuja el {{gl:campo|campo de pendientes}} con segmentos cortos y una curva solución."
     },
     {
      "t": "grafica",
      "animar": "dibujar",
      "alt": "El campo de pendientes y una solución"
     }
    ]
   },
   {
    "titulo": "Piensa antes de ver",
    "corto": "Piensa",
    "bloques": [
     {
      "t": "piensa",
      "pregunta": "En el punto (1, 1) la pendiente que pide la ecuación es menos x por y. ¿Cuánto vale?",
      "opciones": [
       -1,
       0,
       1,
       2
      ],
      "correcta": -1,
      "bien": "Muy bien. Vale menos 1, así que la solución baja ahí. Más abajo se ve el campo.",
      "mal": "Vale menos 1, porque menos 1 por 1 es menos 1. Más abajo se ve el campo."
     }
    ]
   },
   {
    "titulo": "Seguir las pendientes",
    "corto": "Seguir",
    "bloques": [
     {
      "t": "p",
      "html": "Mira cómo cambia la solución al cambiar su condición inicial."
     },
     {
      "t": "acercando",
      "ds": [
       -0.8,
       0.3,
       0.8,
       1
      ],
      "alt": "La curva solución para varios valores iniciales"
     },
     {
      "t": "p",
      "html": "Todas las soluciones tienen la misma forma. Cambiar la condición inicial solo las estira o las encoge en vertical, porque multiplica por la constante."
     }
    ]
   },
   {
    "titulo": "Separar las variables",
    "corto": "Separar",
    "bloques": [
     {
      "t": "p",
      "html": "Se pasan todas las y a un lado, con dy, y todas las x al otro, con dx. Luego se integra cada lado."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "\\dfrac{dy}{dx}=-x\\,y\\ \\Rightarrow\\ \\dfrac{dy}{y}=-x\\,dx",
        "porque": "Se divide entre y y se multiplica por dx."
       },
       {
        "tex": "\\ln|y|=-\\dfrac{x^{2}}{2}+c",
        "porque": "Se integra cada lado."
       },
       {
        "tex": "y=C\\,e^{-x^{2}/2}",
        "porque": "Se aplica la exponencial. La constante positiva e a la c y el signo se juntan en una constante C."
       },
       {
        "tex": "y(0)=3\\ \\Rightarrow\\ C=3",
        "porque": "La condición inicial fija C."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Al dividir entre y se pierde la solución y igual a 0. Aquí no se pierde, porque sale cuando C vale 0."
     }
    ]
   },
   {
    "titulo": "Con una condición inicial",
    "corto": "Con condición inicial",
    "bloques": [
     {
      "t": "p",
      "html": "Un {{gl:pvi|problema de valor inicial}} agrega el valor de la solución en un punto. Eso escoge una curva de la familia."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "y'=3y,\\quad y(0)=2",
        "porque": "La ecuación y la condición inicial."
       },
       {
        "tex": "\\dfrac{dy}{y}=3\\,dx\\ \\Rightarrow\\ \\ln|y|=3x+c\\ \\Rightarrow\\ y=Ce^{3x}",
        "porque": "Se separa e integra."
       },
       {
        "tex": "y(0)=C=2\\ \\Rightarrow\\ y=2e^{3x}",
        "porque": "Se reemplaza la condición inicial."
       }
      ]
     }
    ]
   },
   {
    "titulo": "Qué es una solución",
    "corto": "Solución",
    "bloques": [
     {
      "t": "p",
      "html": "Una solución se comprueba reemplazándola en la ecuación."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "y=Ce^{-x^{2}/2}\\ \\Rightarrow\\ y'=Ce^{-x^{2}/2}\\cdot(-x)=-x\\,y",
        "porque": "Se deriva con la regla de la cadena y se compara."
       },
       {
        "tex": "\\text{Orden de}\\ y''+(y')^{3}+y=0\\ \\text{es 2}",
        "porque": "El orden es la derivada más alta que aparece."
       }
      ]
     }
    ]
   },
   {
    "titulo": "¿Para qué sirve?",
    "corto": "En ingeniería",
    "bloques": [
     {
      "t": "ingenieria",
      "titulo": "El enfriamiento de un motor",
      "html": "Un bloque de motor se enfría al apagarlo. La ley de enfriamiento de Newton dice que la temperatura baja a una velocidad proporcional a la diferencia con el ambiente. Es una ecuación de variables separables.",
      "tex": "\\dfrac{dT}{dt}=-k\\,(T-T_{a})",
      "datos": [
       {
        "k": "Temperatura inicial",
        "v": "90 °C"
       },
       {
        "k": "Temperatura ambiente",
        "v": "20 °C"
       },
       {
        "k": "Constante k",
        "v": "0.05 por minuto"
       }
      ],
      "cierre": "Al separar e integrar queda T igual a 20 más 70 por e a la menos 0.05 t. A los 30 minutos la temperatura es 20 más 70 por e a la menos 1.5, o sea unos 35.6 grados. Es un modelo simplificado, porque supone un ambiente a temperatura constante y una temperatura uniforme en el bloque."
     }
    ]
   },
