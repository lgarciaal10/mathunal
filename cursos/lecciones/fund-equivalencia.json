       5,
       6
      ],
      "correcta": 5,
      "bien": "Muy bien. Son 5, del 0 al 4. Más abajo se ve cada residuo como una columna.",
      "mal": "Son 5, los residuos 0, 1, 2, 3 y 4. Más abajo se ve cada residuo como una columna."
     }
    ]
   },
   {
    "titulo": "Recorriendo las clases",
    "corto": "Las clases",
    "bloques": [
     {
      "t": "p",
