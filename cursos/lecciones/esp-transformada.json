 "leer": {
  "secciones": [
   {
    "titulo": "La idea",
    "bloques": [
     {
      "t": "p",
      "html": "La {{gl:transformada|transformada de Fourier}} es la versión de la serie de Fourier para funciones que no son periódicas. Convierte una función del tiempo en una función de la frecuencia. Tiene propiedades muy útiles. La {{gl:traslacion|traslación}} se vuelve una fase, la derivada se vuelve una multiplicación, y la {{gl:convolucion|convolución}} se vuelve un producto. Y siempre hay una relación de {{gl:incertidumbre|incertidumbre}} entre el ancho en el tiempo y en la frecuencia."
     }
    ]
   },
   {
    "titulo": "Un ejemplo",
    "corto": "Un ejemplo",
    "bloques": [
     {
      "t": "p",
      "html": "La gaussiana es su propia forma en la frecuencia. Mira cómo cambia el ancho de las dos curvas al mover a."
     },
     {
      "t": "eq",
      "tex": "\\mathcal{F}\\{e^{-ax^{2}}\\}(\\omega)=\\dfrac{1}{\\sqrt{2a}}\\,e^{-\\omega^{2}/4a}"
     },
     {
      "t": "grafica",
      "animar": "dibujar",
      "alt": "La gaussiana y su transformada"
     }
    ]
   },
   {
    "titulo": "Piensa antes de ver",
    "corto": "Piensa",
    "bloques": [
     {
      "t": "piensa",
      "pregunta": "Si una función se comprime en el tiempo, ¿su transformada se ensancha o se angosta en la frecuencia?",
      "opciones": [
       "Se ensancha",
       "Se angosta"
      ],
      "correcta": "Se ensancha",
      "bien": "Muy bien. Comprimir en el tiempo ensancha la frecuencia. Más abajo se ve con la gaussiana.",
      "mal": "Se ensancha. Una señal corta contiene muchas frecuencias, y una señal larga contiene pocas. Más abajo se ve con la gaussiana."
     }
    ]
   },
   {
    "titulo": "Variando a",
    "corto": "El parámetro",
    "bloques": [
     {
      "t": "p",
      "html": "Mira las dos gaussianas con a igual a 0.1, 1 y 4."
     },
     {
      "t": "acercando",
      "ds": [
       0.1,
       1,
       4
      ],
      "alt": "Las gaussianas con tres valores de a"
     },
     {
      "t": "p",
      "html": "Con a igual a 4 la gaussiana es angosta y su transformada es ancha y baja. Con a igual a 0.1 es al revés."
     }
    ]
   },
   {
    "titulo": "Propiedades",
    "corto": "Propiedades",
    "bloques": [
     {
      "t": "p",
      "html": "Las propiedades permiten calcular transformadas sin integrar de nuevo."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "\\mathcal{F}\\{f(x-a)\\}=e^{-ia\\omega}\\,\\hat{f}(\\omega)",
        "porque": "Traslación. Solo cambia la fase."
       },
       {
        "tex": "\\mathcal{F}\\{f'(x)\\}=i\\omega\\,\\hat{f}(\\omega)",
        "porque": "Derivada. Se multiplica por i omega."
       },
       {
        "tex": "\\mathcal{F}\\{f(ax)\\}=\\dfrac{1}{|a|}\\,\\hat{f}\\!\\left(\\dfrac{\\omega}{a}\\right)",
        "porque": "Escalamiento. Comprimir en x ensancha en omega."
       },
       {
        "tex": "\\mathcal{F}\\{f*g\\}\\propto\\hat{f}(\\omega)\\,\\hat{g}(\\omega)",
        "porque": "Convolución. Se vuelve un producto."
       }
      ]
     },
