 "leer": {
  "secciones": [
   {
    "titulo": "La idea",
    "bloques": [
     {
      "t": "p",
      "html": "La {{gl:laplace|transformada de Laplace}} cambia una función de t por otra función de s. Su gran ventaja es que convierte derivadas en multiplicaciones, y así una ecuación diferencial se vuelve una ecuación algebraica. Se resuelve el álgebra y se regresa. Es la herramienta principal de la ingeniería de control y de los circuitos."
     }
    ]
   },
   {
    "titulo": "Un ejemplo",
    "corto": "Un ejemplo",
    "bloques": [
     {
      "t": "p",
      "html": "Mira cómo se calcula la transformada de e a la t."
     },
     {
      "t": "eq",
      "tex": "\\mathcal{L}\\{e^{t}\\}=\\int_{0}^{\\infty}e^{-st}\\,e^{t}\\,dt=\\int_{0}^{\\infty}e^{-(s-1)t}\\,dt"
     },
     {
      "t": "grafica",
      "animar": "dibujar",
      "alt": "La curva que se integra y su área"
     }
    ]
   },
   {
    "titulo": "Piensa antes de ver",
    "corto": "Piensa",
    "bloques": [
     {
      "t": "piensa",
      "pregunta": "La curva es y igual a e a la menos t. ¿Cuánto vale en t igual a 0?",
      "opciones": [
       0,
       0.5,
       1,
       2
      ],
      "correcta": 1,
      "bien": "Muy bien. Vale 1, porque e a la 0 es 1. Más abajo se ve el área.",
      "mal": "Vale 1, porque e a la 0 es 1. Más abajo se ve el área."
     }
    ]
   },
   {
    "titulo": "El área",
    "corto": "El área",
    "bloques": [
     {
      "t": "p",
      "html": "Mira cómo cambia el área al subir s."
     },
     {
      "t": "acercando",
      "ds": [
       1.3,
       2,
       3.5
      ],
      "alt": "El área bajo la curva para varios valores de s"
     },
     {
      "t": "p",
      "html": "Con s igual a 2 el área vale <b>1</b>. En general vale 1 sobre s menos 1, siempre que s sea mayor que 1."
     }
    ]
   },
   {
    "titulo": "Calcular la integral",
    "corto": "Calcular",
    "bloques": [
     {
      "t": "pasos",
      "items": [
       {
        "tex": "\\int_{0}^{\\infty}e^{-(s-1)t}\\,dt=\\lim_{T\\to\\infty}\\left[\\dfrac{-e^{-(s-1)t}}{s-1}\\right]_{0}^{T}",
        "porque": "Es una integral impropia."
       },
       {
        "tex": "=\\dfrac{1}{s-1}\\quad (s>1)",
        "porque": "Si s es mayor que 1 el límite es 0, y queda el término de t igual a 0."
       }
      ]
     },
     {
      "t": "ojo",
      "html": "Si s es menor o igual que 1 la integral diverge y la transformada no existe."
     }
    ]
   },
   {
    "titulo": "Tabla básica",
    "corto": "Tabla",
    "bloques": [
     {
      "t": "p",
      "html": "Estas son las transformadas que más se usan. Con ellas casi no hace falta integrar."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "\\mathcal{L}\\{1\\}=\\dfrac{1}{s},\\qquad \\mathcal{L}\\{t\\}=\\dfrac{1}{s^{2}}",
        "porque": "La constante y la rampa."
       },
       {
        "tex": "\\mathcal{L}\\{e^{at}\\}=\\dfrac{1}{s-a}",
        "porque": "La exponencial, que es el ejemplo de la lección."
       },
       {
        "tex": "\\mathcal{L}\\{\\operatorname{sen}\\omega t\\}=\\dfrac{\\omega}{s^{2}+\\omega^{2}},\\quad \\mathcal{L}\\{\\cos\\omega t\\}=\\dfrac{s}{s^{2}+\\omega^{2}}",
        "porque": "Las oscilaciones."
       },
       {
        "tex": "\\mathcal{L}\\{f'\\}=sF(s)-f(0)",
        "porque": "La derivada se vuelve una multiplicación."
       }
      ]
     }
    ]
   },
   {
    "titulo": "Resolver una EDO",
    "corto": "Resolver una EDO",
    "bloques": [
     {
      "t": "p",
      "html": "Se transforma toda la ecuación y se despeja la transformada de la solución."
     },
     {
      "t": "pasos",
      "items": [
       {
        "tex": "y'+y=1,\\quad y(0)=0",
        "porque": "La ecuación del condensador con fuente de 1."
       },
       {
        "tex": "sY-0+Y=\\dfrac{1}{s}\\ \\Rightarrow\\ Y=\\dfrac{1}{s(s+1)}",
        "porque": "Se transforma y se despeja Y."
       },
       {
        "tex": "Y=\\dfrac{1}{s}-\\dfrac{1}{s+1}\\ \\Rightarrow\\ y=1-e^{-t}",
        "porque": "Se parte en fracciones parciales y se regresa con la tabla."
       }
      ]
     }
    ]
   },
   {
    "titulo": "¿Para qué sirve?",
    "corto": "En ingeniería",
    "bloques": [
